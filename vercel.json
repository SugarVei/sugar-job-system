{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/mailbox-fetch.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/profile-ai-analyze.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/profile-resume-parse.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
