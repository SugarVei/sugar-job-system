{
  "manifest_version": 3,
  "name": "Sugar 智能填表助手",
  "version": "1.0.3",
  "description": "从 Sugar 求职系统同步资料，在当前招聘表单中填写可安全填写的字段。",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://sugar-job-system.vercel.app/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Sugar 智能填表助手", "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }]
}
