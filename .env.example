# ============================================================
# Supabase 配置（复制本文件为 .env 后填写真实值）
# 这两个值在 Supabase 控制台 → Project Settings → API 中获取
# 注意：anon key 是公开可用的前端密钥，安全由 RLS 行级安全策略保障；
#       绝不要把 service_role key 放到前端。
# ============================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Vercel API 使用的服务端变量。本地不填也能启动前端。
ALLOWED_ORIGIN=http://localhost:5173
DEEPSEEK_API_KEY=

# 智能填表助手服务端变量：只放在 Vercel/本机服务端，绝不能加 VITE_ 前缀。
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=
# 32 字节随机密钥，例如：openssl rand -hex 32
AI_CREDENTIAL_MASTER_KEY=

# 可选：Vercel 每日校招同步任务的增强鉴权。未配置时仅接受 Vercel Cron 请求，
# 并由服务端限制 20 小时内最多执行一次；如配置，请使用至少 16 位随机字符串。
CRON_SECRET=

# 可选：允许更新共享标准公司库的登录邮箱，逗号分隔。
# 未配置时，任意已登录账号都可以预览并写入（适合个人站点）。
STANDARD_CATALOG_ADMIN_EMAIL=
